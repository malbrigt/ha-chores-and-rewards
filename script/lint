#!/usr/bin/env bash
# Format + lint. Pass --check to only verify (CI).
set -euo pipefail
cd "$(dirname "$0")/.."
if [ "${1:-}" = "--check" ]; then
  .venv/bin/ruff format --check .
  .venv/bin/ruff check .
  .venv/bin/mypy custom_components/chores_and_rewards
else
  .venv/bin/ruff format .
  .venv/bin/ruff check --fix .
  .venv/bin/mypy custom_components/chores_and_rewards
fi
